node n7 {
    type host
    network-config {
	hostname Telnet
	!
	interface eth0
	 ip address 10.0.2.10/24
	 ipv6 address fc00:2::10/64
	 mac address 42:00:aa:00:00:0a
	!
	interface lo0
	 type lo
	 ip address 127.0.0.1/8
	 ipv6 address ::1/128
	!
	ip route 0.0.0.0/0 10.0.2.1
	!
	ipv6 route ::/0 fc00:2::1
	!
    }
    canvas c0
    iconcoords {912 216}
    labelcoords {912 252}
    services {telnet}
    interface-peer {eth0 n3}
    custom-configs {
        custom-config-id default {
            custom-command /bin/sh
            config {
                ip addr add 127.0.0.1/8 dev lo0
                ip addr add 10.0.2.10/24 dev eth0
                ip -6 addr add ::1/128 dev lo0
                ip -6 addr add fc00:2::10/64 dev eth0
                
                ip route add 0.0.0.0/0 via 10.0.2.1
                ip -6 route add ::/0 via fc00:2::1
                
                rpcbind
                inetd
                
            }
        }
    }
    custom-selected default
}

