link l0 {
    nodes {n4 n2}
    bandwidth 0
}

link l1 {
    nodes {n5 n4}
    bandwidth 0
}

link l2 {
    delay 50000
    nodes {n3 n5}
    bandwidth 0
}

link l3 {
    nodes {n0 n2}
    events {
	5 bandwidth ramp 128000 8000 2
	10 delay rand 80000 120000 8
	15 delay square 100000 200000 10
	20 ber const 1
	25 ber const 0
	30 delay const 0
	35 bandwidth const 0
    }
}

link l4 {
    nodes {n1 n2}
    bandwidth 0
}

link l5 {
    nodes {n6 n4}
    bandwidth 0
}

link l6 {
    nodes {n5 n6}
    bandwidth 0
}

link l7 {
    nodes {n3 n7}
    bandwidth 0
}

link l8 {
    nodes {n8 n3}
    bandwidth 0
}

link l9 {
    nodes {n2 n9}
    bandwidth 0
    events {
    }
}

link l10 {
    nodes {n5 n10}
    bandwidth 0
}

canvas c0 {
    name {Canvas0}
    size {2000 1000}
}

option show {
    interface_names no
    ip_addresses yes
    ipv6_addresses yes
    node_labels yes
    link_labels yes
    background_images no
    annotations yes
    hostsAutoAssign no
    grid yes
    iconSize normal
    zoom 1.0
}

